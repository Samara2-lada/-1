import math
while(True):
    try:
        x = int(input("Введите число"))
        if x <= 0:
            print("Ошибка: X должен быть больше нуля")
        else:
            result = (math.cos(x) ** math.sin(x)) + (math.exp(2 * x) / math.sqrt(x))
            result = result.real
            print(input(result))
            if int(result) % 2 == 0:
                input("Результат чётный")
            else:
                input("Результат нечётный")
            if int(result) < 0:
                input("Результат отрицательный")
            else:
                input("Результат положительный")
        break
    except ValueError:
        print("Ошибка: пожалуйста, введите целое число")
